#: models.py:82
msgid "The Django Site this profile extends. Each Site can have one profile."
msgstr ""
"A Django-webhely, amelyet ez a profil kiegészít. Minden webhelynek egy "
"profilja lehet."

#: models.py:88
msgid ""
"Display name shown to users. Can differ from Site.name (e.g., 'My Awesome "
"App')."
msgstr ""
"A felhasználóknak megjelenített név. Eltérhet a Site.name értékétől (pl. 'My "
"Awesome App')."

#: models.py:93
msgid ""
"Short slogan or description (e.g., 'The best way to manage your tasks')."
msgstr ""
"Rövid szlogen vagy leírás (pl. 'A legjobb módja a feladatai kezelésének')."

#: models.py:98
msgid ""
"Theme identifier used for CSS styling. Maps to DaisyUI theme or custom CSS "
"class."
msgstr ""
"A CSS-stílusokhoz használt téma azonosítója. Egy DaisyUI-témának vagy egyéni "
"CSS-osztálynak felel meg."

#: models.py:104
msgid ""
"Template subdirectory name under templates/. If empty, defaults to first part"
" of domain (e.g., 'mysite' for mysite.example.com). Templates here override "
"defaults."
msgstr ""
"A sablonok alkönyvtárának neve a templates/ alatt. Ha üres, a domain első "
"része lesz az alapértelmezés (pl. 'mysite' a mysite.example.com esetén). Az "
"itt lévő sablonok felülírják az alapértelmezetteket."

#: models.py:112
msgid ""
"Site logo image. Recommended: SVG or PNG with transparent background, min "
"200px wide."
msgstr ""
"A webhely logója. Ajánlott: SVG vagy átlátszó hátterű PNG, legalább 200px "
"széles."

#: models.py:118
msgid "Browser favicon. Recommended: 32x32 or 64x64 PNG, or ICO format."
msgstr ""
"Böngésző-favicon. Ajánlott: 32x32-es vagy 64x64-es PNG, illetve ICO formátum."

#: models.py:123
msgid ""
"Primary brand color in hex format (e.g., #3B82F6). Used for buttons, links, "
"accents."
msgstr ""
"Az elsődleges márkaszín hex formátumban (pl. #3B82F6). Gombokhoz, "
"hivatkozásokhoz, kiemelésekhez használatos."

#: models.py:126
msgid "Secondary brand color in hex format. Used for hover states, etc."
msgstr ""
"A másodlagos márkaszín hex formátumban. Rámutatási állapotokhoz stb. "
"használatos."

#: models.py:190
msgid ""
"Custom CSS styles for this site. Injected inline in &lt;head&gt;. Use for "
"color overrides, custom fonts, or site-specific tweaks."
msgstr ""
"Egyéni CSS-stílusok ehhez a webhelyhez. Közvetlenül a &lt;head&gt; részbe "
"kerülnek. Színek felülírására, egyéni betűtípusokhoz vagy webhelyspecifikus "
"finomításokhoz használja."

#: models.py:199
msgid "Default language code (ISO 639-1). Examples: en, ro, fr, de, es."
msgstr ""
"Az alapértelmezett nyelv kódja (ISO 639-1). Példák: en, ro, fr, de, es."

#: models.py:213
msgid ""
"Default timezone for this site. Examples: UTC, Europe/Bucharest, "
"America/New_York."
msgstr ""
"A webhely alapértelmezett időzónája. Példák: UTC, Europe/Bucharest, "
"America/New_York."

#: models.py:289
msgid "Isolated - Each domain has its own users"
msgstr "Elkülönített: minden domainnek saját felhasználói vannak"

#: models.py:290
msgid "Shared - Cross-domain authentication via auth domain"
msgstr ""
"Megosztott: domainek közötti hitelesítés a hitelesítési domainen keresztül"

#: models.py:297
msgid ""
"<strong>Isolated:</strong> Users are separate per domain. "
"<strong>Shared:</strong> Single sign-on across domains via a central auth "
"domain."
msgstr ""
"<strong>Elkülönített:</strong> a felhasználók domainenként külön vannak. "
"<strong>Megosztott:</strong> egyszeri bejelentkezés a domainek között egy "
"központi hitelesítési domainen keresztül."

#: models.py:308
msgid ""
"For shared auth mode: select the SiteProfile that handles login. Users will "
"be redirected there to authenticate, then back with a JWT token."
msgstr ""
"Megosztott hitelesítési módhoz: válassza ki a bejelentkezést kezelő "
"SiteProfile-t. A felhasználók oda lesznek átirányítva hitelesítésre, majd egy"
" JWT-tokennel vissza."

#: models.py:315
msgid ""
"Check this if this site is the central authentication provider. Other sites "
"in shared mode will redirect here for login."
msgstr ""
"Jelölje be, ha ez a webhely a központi hitelesítésszolgáltató. A megosztott "
"módú többi webhely ide irányít át bejelentkezéshez."

#: models.py:377
msgid "Inactive sites return 404. At least one site must remain active."
msgstr ""
"Az inaktív webhelyek 404-et adnak vissza. Legalább egy webhelynek aktívnak "
"kell maradnia."

#: models.py:381
msgid ""
"The primary/default site. Used when no domain matches. Only one site can be "
"primary."
msgstr ""
"Az elsődleges/alapértelmezett webhely. Akkor használatos, ha egyik domain sem"
" egyezik. Csak egy webhely lehet elsődleges."

#: models.py:387
msgid ""
"Development only: access this site via path prefix (e.g., '/mysite' for "
"localhost:8000/mysite/). Leave empty for production domain-based routing."
msgstr ""
"Csak fejlesztéshez: a webhely elérése útvonal-előtaggal (pl. '/mysite' a "
"localhost:8000/mysite/ címhez). Éles, domainalapú útválasztáshoz hagyja "
"üresen."

#: models.py:394
msgid "Site Profiles"
msgstr "Webhelyprofilok"

#: models.py:410
msgid ""
"Cannot deactivate the last active site. At least one site must remain active."
msgstr ""
"Az utolsó aktív webhely nem kapcsolható ki. Legalább egy webhelynek aktívnak "
"kell maradnia."

#: models.py:421
msgid "Cannot unset primary. At least one site must be primary."
msgstr ""
"Az elsődleges jelölés nem szüntethető meg. Legalább egy webhelynek "
"elsődlegesnek kell lennie."

#: models.py:430
#, python-format
msgid ""
"template_dir may contain only lowercase letters, digits, hyphens, and "
"underscores (no dots or slashes), max %(max)d characters."
msgstr ""
"A template_dir csak kisbetűket, számjegyeket, kötőjeleket és aláhúzásjeleket "
"tartalmazhat (pontot és perjelet nem), legfeljebb %(max)d karaktert."

#: models.py:450
msgid "{field_name} must be a string URL, not {type(origin).__name__}"
msgstr ""
"A(z) {field_name} értékének szöveges URL-nek kell lennie, nem "
"{type(origin).__name__}"

#: models.py:455
#, python-brace-format
msgid "{field_name}: Wildcards are not allowed for security reasons."
msgstr ""
"{field_name}: biztonsági okokból helyettesítő karakterek nem engedélyezettek."

#: models.py:464
#, python-brace-format
msgid ""
"{field_name}: '{origin}' is not a valid URL. Must include scheme "
"(http/https)."
msgstr ""
"{field_name}: a(z) '{origin}' nem érvényes URL. Tartalmaznia kell a sémát "
"(http/https)."

#: models.py:469
#, python-brace-format
msgid "{field_name}: '{origin}' must use http or https scheme."
msgstr "{field_name}: a(z) '{origin}' csak http vagy https sémát használhat."

#: models.py:474
#, python-brace-format
msgid ""
"{field_name}: '{origin}' should not include a path. Use origin only (e.g., "
"https://example.com)."
msgstr ""
"{field_name}: a(z) '{origin}' nem tartalmazhat útvonalat. Csak a forrást adja"
" meg (pl. https://example.com)."

#: models.py:481
#, python-brace-format
msgid "{field_name}: '{origin}' is not a valid URL: {e}"
msgstr "{field_name}: a(z) '{origin}' nem érvényes URL: {e}"

#: models.py:490
msgid "{field_name} must be a list of URLs, not {type(origins).__name__}"
msgstr ""
"A(z) {field_name} értékének URL-ek listájának kell lennie, nem "
"{type(origins).__name__}"

#: models.py:716
msgctxt "site member role"
msgid "Admin"
msgstr "Adminisztrátor"

#: models.py:717
msgctxt "site member role"
msgid "Viewer"
msgstr "Megtekintő"

#: models.py:723
msgid "The site this membership belongs to."
msgstr "A webhely, amelyhez ez a tagság tartozik."

#: models.py:729
msgid "The user who has access to this site."
msgstr "A felhasználó, aki hozzáfér ehhez a webhelyhez."

#: models.py:735
msgid "User's role on this site. Admin has full access, Viewer is read-only."
msgstr ""
"A felhasználó szerepköre ezen a webhelyen. Az adminisztrátor teljes "
"hozzáféréssel rendelkezik, a megtekintő csak olvashat."

#: models.py:739
msgid "If true, this user is the site owner and cannot be removed."
msgstr ""
"Ha be van jelölve, ez a felhasználó a webhely tulajdonosa, és nem távolítható"
" el."

#: models.py:743
msgid "Site Member"
msgstr "Webhelytag"

#: models.py:744
msgid "Site Members"
msgstr "Webhelytagok"

#: models.py:760
msgid "Cannot remove owner status. Transfer ownership first."
msgstr ""
"A tulajdonosi státusz nem vonható vissza. Először ruházza át a tulajdonjogot."

#: models.py:762
msgid "Site owner must be an admin."
msgstr "A webhely tulajdonosának adminisztrátornak kell lennie."
