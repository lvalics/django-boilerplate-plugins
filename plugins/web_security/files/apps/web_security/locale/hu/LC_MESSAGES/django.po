#: models/suspicious_request.py:16
msgid "IP Address"
msgstr "IP cím"

#: admin/suspicious_admin.py:121 models/suspicious_request.py:20
msgid "Path"
msgstr "Útvonal"

#: admin/suspicious_admin.py:125 admin/threat_pattern_admin.py:70
#: models/suspicious_request.py:69 models/threat_pattern.py:205
msgid "Threat Level"
msgstr "Fenyegetési szint"

#: admin/threat_pattern_admin.py:14
msgid "Threat Detection Patterns"
msgstr "Fenyegetésészlelési minták"

#: admin/threat_pattern_admin.py:16
msgid ""
"Define <strong>regex patterns</strong> to detect malicious requests. Patterns"
" can match against URL paths, user agents, headers, or request bodies. Each "
"pattern has a category, threat level, and score. Use <code>python manage.py "
"seed_patterns</code> to load default patterns."
msgstr ""
"Adjon meg <strong>regex mintákat</strong> a rosszindulatú kérések "
"észleléséhez. A minták illeszkedhetnek URL-útvonalakra, user agentekre, "
"fejlécekre vagy a kérések törzsére. Minden mintának van kategóriája, "
"fenyegetési szintje és pontszáma. Az alapértelmezett minták betöltéséhez "
"használja a <code>python manage.py seed_patterns</code> parancsot."

#: admin/threat_pattern_admin.py:49
msgid "Pattern Configuration"
msgstr "Minta beállításai"

#: admin/threat_pattern_admin.py:52
msgid "Configure the regex pattern and what it matches against."
msgstr "Állítsa be a regex mintát, és hogy mire illeszkedjen."

#: admin/threat_pattern_admin.py:56
msgid "Classification"
msgstr "Besorolás"

#: admin/threat_pattern_admin.py:88
msgid "Activate selected patterns"
msgstr "A kijelölt minták aktiválása"

#: admin/threat_pattern_admin.py:91
msgid "{} patterns activated."
msgstr "{} minta aktiválva."

#: admin/threat_pattern_admin.py:93
msgid "Deactivate selected patterns"
msgstr "A kijelölt minták inaktiválása"

#: admin/threat_pattern_admin.py:96
msgid "{} patterns deactivated."
msgstr "{} minta inaktiválva."

#: admin/threat_summary_admin.py:15 models/ip_threat_summary.py:94
msgid "IP Threat Summaries"
msgstr "IP-fenyegetési összesítők"

#: admin/threat_summary_admin.py:17
msgid ""
"Aggregated threat data <strong>per IP address</strong>. Shows total threat "
"score, request count, and block status. Use actions to manually block/unblock"
" IPs or sync to firewall. IPs exceeding the auto-block threshold are "
"automatically blocked."
msgstr ""
"Összesített fenyegetési adatok <strong>IP-címenként</strong>. Mutatja a "
"teljes fenyegetési pontszámot, a kérések számát és a tiltási állapotot. A "
"műveletekkel kézzel tilthat le vagy oldhat fel IP-címeket, illetve "
"szinkronizálhat a tűzfallal. Az automatikus tiltási küszöböt meghaladó IP-"
"címek automatikusan tiltásra kerülnek."

#: admin/threat_summary_admin.py:59
msgid "Block Status"
msgstr "Tiltási állapot"

#: admin/threat_summary_admin.py:71
msgid "Detection Details"
msgstr "Az észlelés részletei"

#: admin/threat_summary_admin.py:77
