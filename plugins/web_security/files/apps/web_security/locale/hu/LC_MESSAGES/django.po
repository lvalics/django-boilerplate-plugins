#: admin/threat_summary_admin.py:96
msgid "{} IPs blocked."
msgstr "{} IP-cím letiltva."

#: admin/threat_summary_admin.py:98
msgid "Unblock selected IPs"
msgstr "A kijelölt IP-címek feloldása"

#: admin/threat_summary_admin.py:106
msgid "{} IPs unblocked."
msgstr "{} IP-cím feloldva."

#: admin/threat_summary_admin.py:108
msgid "Sync to firewall"
msgstr "Szinkronizálás a tűzfallal"

#: admin/threat_summary_admin.py:114
msgid "No firewall service configured."
msgstr "Nincs beállított tűzfalszolgáltatás."

#: admin/threat_summary_admin.py:119
